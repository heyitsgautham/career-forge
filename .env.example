# Values docker-compose.yml reads from a .env file at the repo root.
# Copy to .env and fill in what you need. Every value has a default in the compose file.
# For running the backend or frontend outside Docker, see project/backend/.env.example
# and project/frontend/.env.example, which list every setting each one reads.

# --- Backend container ---
# Both secrets have local-only defaults in the compose file. Set real ones for anything shared.
JWT_SECRET_KEY=
SECRET_KEY=
AWS_REGION=us-east-1

# --- Frontend image build ---
# Next.js inlines NEXT_PUBLIC_* values into the browser bundle when the image builds,
# so changing one needs `docker compose build frontend`.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# The GitHub sign-in and repo import buttons log an error and do nothing until these are set.
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GITHUB_APP_SLUG=
# The Google sign-in button, which uses the Cognito hosted UI, does the same.
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# --- Daily job digest Lambda (project/lambda/daily-job-digest) ---
# template.yaml sets these when SAM deploys the function. They only matter
# when you call lambda_handler yourself, for example from a Python shell.
DYNAMODB_TABLE=Jobs
SNS_TOPIC_ARN=
TOP_JOBS_COUNT=5
