# CareerForge backend settings, read by app/core/config.py.
# Copy to project/backend/.env and fill in what you need.
# Every value here has a default in config.py, so an empty .env still starts the API.

# --- Application ---
APP_NAME=careerforge
APP_ENV=development
DEBUG=true

# --- Storage backend ---
# true uses DynamoDB tables (needs AWS credentials). false uses SQLite at DATABASE_URL.
USE_DYNAMO=false
DYNAMO_TABLE_PREFIX=
DATABASE_URL=sqlite+aiosqlite:///./latex_agent.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- Secrets ---
# With USE_SECRETS_MANAGER=true, any secret below left at its default is fetched
# from AWS Secrets Manager at startup. Set it to false for offline local work.
USE_SECRETS_MANAGER=false
SM_JWT_SECRET_NAME=careerforge/jwt-secret-key
SM_APP_SECRET_NAME=careerforge/app-secret-key
SM_GITHUB_CLIENT_SECRET_NAME=careerforge/github-app-client-secret
SM_COGNITO_CLIENT_SECRET_NAME=careerforge/cognito-app-client-secret
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Fernet key material for legacy encrypted tokens
SECRET_KEY=change-me-in-production

# --- AWS ---
# Credentials come from the standard AWS chain (env vars, ~/.aws, instance role).
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
KMS_KEY_ID=alias/careerforge-tokens
S3_BUCKET=your-careerforge-pdf-bucket
BEDROCK_MODEL_ID=us.anthropic.claude-3-7-sonnet-20250219-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_TEMPERATURE=0.2
BEDROCK_MAX_TOKENS=8192

# --- ChromaDB (job description embeddings) ---
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./chroma_data

# --- GitHub App (repo import) ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=careerforge
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_SECRET=careerforge/github-app-private-key
# Legacy OAuth app, used when the GitHub App values are empty
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/callback/github

# --- AWS Cognito (Google sign-in) ---
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
# Never commit this. Leave empty to load it from Secrets Manager.
COGNITO_APP_CLIENT_SECRET=
COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
COGNITO_CALLBACK_URL=http://localhost:3000/api/auth/callback/cognito

# --- LinkedIn OAuth ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:3000/api/auth/callback/linkedin

# --- LaTeX compilation ---
LATEX_COMPILER_TIMEOUT=30
LATEX_COMPILER_MEMORY_LIMIT=256m
