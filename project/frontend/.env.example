# CareerForge frontend settings. Copy to project/frontend/.env.local.
# Next.js inlines NEXT_PUBLIC_* values into the browser bundle at build time.

# Backend base URL, used by the axios client and the /api rewrite in next.config.js
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL of this app, used to build OAuth redirect URIs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub OAuth app client id (login) and GitHub App slug (repo import)
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GITHUB_APP_SLUG=

# AWS Cognito hosted UI for Google sign-in
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
